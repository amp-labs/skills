      },
      {
        "command": "/bin/bash -lc \"python3 -c 'import urllib.request; urllib.request.urlretrieve(\\\"https://github.com/amp-labs/cli/releases/download/v1.0.7/ampersand-cli_1.0.7+git-1_amd64.deb\\\", \\\"/tmp/ampersand-cli.deb\\\")' && dpkg-deb -x /tmp/ampersand-cli.deb /tmp/ampersand-cli && /tmp/ampersand-cli/usr/local/ampersand-cli/bin/amp deploy --help\""
      },
      {
        "command": "/bin/bash -lc \"node -e 'fetch(\\\"https://github.com/amp-labs/cli/releases/download/v1.0.7/ampersand-cli_1.0.7+git-1_amd64.deb\\\").then(async r=>{if(\"'!r.ok)throw Error(`HTTP ${r.status}`);require(\"fs\").writeFileSync(\"/tmp/ampersand-cli.deb\",Buffer.from(await r.arrayBuffer()))}).catch(e=>{console.error(e);process.exit(1)})'\"' && dpkg-deb -x /tmp/ampersand-cli.deb /tmp/ampersand-cli && /tmp/ampersand-cli/usr/local/ampersand-cli/bin/amp deploy --help\""
